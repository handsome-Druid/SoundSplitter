#!/usr/bin/make -f

APP_DIR = debian/soundsplitter/usr/lib/SoundSplitter

%:
	dh $@

override_dh_auto_configure override_dh_auto_build override_dh_auto_test override_dh_auto_clean:

override_dh_auto_install:
	readelf -h build/SoundSplitter.dist/SoundSplitter.bin > /dev/null
	install -d $(APP_DIR)
	cp -a build/SoundSplitter.dist/. $(APP_DIR)/
	chmod 0755 $(APP_DIR)/SoundSplitter.bin
	install -D -m 0755 debian/soundsplitter-launcher debian/soundsplitter/usr/bin/soundsplitter
	install -D -m 0644 debian/soundsplitter.desktop debian/soundsplitter/usr/share/applications/soundsplitter.desktop
	install -D -m 0644 debian/io.github.handsome_druid.SoundSplitter.metainfo.xml \
		debian/soundsplitter/usr/share/metainfo/io.github.handsome_druid.SoundSplitter.metainfo.xml
	install -D -m 0644 debian/soundsplitter.catalog.yml \
		debian/soundsplitter/var/lib/swcatalog/yaml/soundsplitter.yml
	install -D -m 0644 src/SoundSplitter/integration/app/resources/SS_headphones_solid_cute.svg \
		debian/soundsplitter/usr/share/icons/hicolor/scalable/apps/soundsplitter.svg

# Preserve precompiled Nuitka binaries.
override_dh_strip override_dh_dwz:

override_dh_shlibdeps:
	dh_shlibdeps -l"$$(find $(CURDIR)/$(APP_DIR) -type d -printf '%p:')" -- --ignore-missing-info

override_dh_builddeb:
	mkdir -p $(CURDIR)/build
	dh_builddeb --destdir=$(CURDIR)/build